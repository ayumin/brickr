# ---------------------------------------------------------------------------
# LLM Providers (Backend only. Never expose these to the frontend.)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local (host) connection
DATABASE_URL=postgresql://brickr:brickr@localhost:5432/brickr?schema=public
# Inside docker compose the backend uses postgresql://brickr:brickr@db:5432/brickr

POSTGRES_USER=brickr
POSTGRES_PASSWORD=brickr
POSTGRES_DB=brickr

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Timeout for a single LLM call (ms)
LLM_TIMEOUT_MS=30000
# Retries per LLM call (0 or 1 is enough, never unbounded)
LLM_MAX_RETRIES=1

# Responder selection tuning
MIN_RESPONDERS=2
MAX_RESPONDERS=6
# Max posts handed to the LLM as conversation context
CONTEXT_POST_LIMIT=16
# How many characters may call the LLM at the same time
MAX_CONCURRENT_CHARACTERS=4
# How deep character-to-character conversations may cascade
MAX_CASCADE_DEPTH=2

# Set to true to run without any provider keys (returns canned text).
# Useful for UI work and e2e smoke tests.
USE_MOCK_LLM=false

# ---------------------------------------------------------------------------
# Frontend (build time, must be VITE_ prefixed)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
