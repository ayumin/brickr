# ---------------------------------------------------------------------------
# LLM Providers (Backend only. Never expose these to the frontend.)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local (host) connection
DATABASE_URL=postgresql://brickr:brickr@localhost:5432/brickr?schema=public
# Inside docker compose the backend uses postgresql://brickr:brickr@db:5432/brickr

POSTGRES_USER=brickr
POSTGRES_PASSWORD=brickr
POSTGRES_DB=brickr

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Timeout for a single LLM call (ms)
LLM_TIMEOUT_MS=30000
# Retries per LLM call (0 or 1 is enough, never unbounded)
LLM_MAX_RETRIES=1

# Responder selection tuning
MIN_RESPONDERS=2
MAX_RESPONDERS=6
# Max posts handed to the LLM as conversation context
CONTEXT_POST_LIMIT=16
# How many characters may call the LLM at the same time
MAX_CONCURRENT_CHARACTERS=4
# How deep character-to-character conversations may cascade
MAX_CASCADE_DEPTH=2

# ---------------------------------------------------------------------------
# Authentication (CLAUDE.md 66)
# ---------------------------------------------------------------------------
# Lifetime of a login session in ms (default: 7 days)
SESSION_TTL_MS=604800000
# Add the Secure attribute to the session cookie. Leave false for local http,
# set to true for any https deployment.
SESSION_COOKIE_SECURE=false

# First administrator, created by the seed. Signup is invite-only, so this is
# the only account that can exist without an invite code.
# Leave ADMIN_EMAIL empty to skip the bootstrap entirely.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_HANDLE=admin
ADMIN_DISPLAY_NAME=管理者

# Set to true to run without any provider keys (returns canned text).
# Useful for UI work and e2e smoke tests.
USE_MOCK_LLM=false

# ---------------------------------------------------------------------------
# Worker process (apps/backend/src/worker/)
# ---------------------------------------------------------------------------
# How long to sleep between polls when the queue is empty (ms)
WORKER_POLL_INTERVAL_MS=2000
# Random jitter added to the poll interval to spread concurrent replicas (ms)
WORKER_POLL_JITTER_MS=1000
# Maximum execution attempts before an event is permanently failed
WORKER_MAX_ATTEMPTS=4
# Port for the worker's /health endpoint
WORKER_HEALTH_PORT=3001

# ---------------------------------------------------------------------------
# Frontend (build time, must be VITE_ prefixed)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
