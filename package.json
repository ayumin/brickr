{
  "name": "enjo-simulator",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter @enjo/backend dev",
    "dev:frontend": "pnpm --filter @enjo/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @enjo/backend seed",
    "db:push": "pnpm --filter @enjo/backend db:push"
  }
}
