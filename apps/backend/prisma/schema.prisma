// Brickr — MVP schema.
//
// Keep the schema small: characters, model_profiles, rooms, posts, and
// the singleton editable user profile.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Polymorphic member kind: distinguishes a real user from an AI character.
enum MemberKind {
  user
  character
}

/// Role within a room. Only users may be owners; characters are always members.
/// This constraint is enforced at the service layer, not at the DB level.
enum MemberRole {
  owner
  member
}

/// Lifecycle state of a room membership.
/// Allowed transitions (enforced at the service layer):
///   pending  → active | removed | banned
///   active   → left   | removed | banned
///   left     → active (re-join)
///   removed  → active (re-invite) | banned
///   banned   → removed (only)
enum MemberStatus {
  active
  pending
  left
  removed
  banned
}

/// Visibility of a room to non-members.
///
/// Schema management note: this project uses `prisma db push --accept-data-loss`
/// (see docker-entrypoint.sh) rather than `prisma migrate dev`, so no migration
/// file is generated. The `--accept-data-loss` flag instructs Prisma to issue the
/// necessary `ALTER COLUMN ... TYPE "RoomVisibility" USING (visibility::text::"RoomVisibility")`
/// DDL automatically when the schema is pushed to the database.
enum RoomVisibility {
  /// Visible and joinable by anyone.
  public
  /// Visible to anyone; joining requires approval.
  open
  /// Visible to members only; joining requires an invitation.
  closed
  /// Invisible and invite-only.
  private
}

model ModelProfile {
  id         String   @id
  providerId String   @map("provider_id")
  model      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  characters Character[]

  @@map("model_profiles")
}

model Character {
  id String @id

  /// Uniqueness is enforced by the shared `handles` table, not by this column,
  /// because users and characters share one handle namespace (CLAUDE.md §66.13).
  handle      String
  displayName String @map("display_name")
  description String

  // Persona. Never exposed through the public API.
  rolePrompt    String  @map("role_prompt")
  tonePrompt    String  @map("tone_prompt")
  dialectPrompt String? @map("dialect_prompt")

  interests String[] @default([])

  // Behaviour. Also internal-only.
  activityLevel       Float @default(0.5) @map("activity_level")
  responseProbability Float @default(0.5) @map("response_probability")
  replyProbability    Float @default(0.6) @map("reply_probability")
  quoteProbability    Float @default(0.2) @map("quote_probability")
  influence           Float @default(0.5)

  /// Selects the BehaviorProfile archetype for autonomous Cast participation.
  /// Null means the `casual` default profile is used (see behavior-profiles.ts).
  behaviorProfileKey String? @map("behavior_profile_key")

  /// Whether this character may join rooms autonomously as a Cast member.
  /// Defaults to true; set to false to keep the character purely reactive.
  castAutonomous Boolean @default(true) @map("cast_autonomous")

  modelProfileId String  @map("model_profile_id")
  avatarUrl      String? @map("avatar_url") @db.Text

  /// Null means "System-owned" — every existing seed Character, forever (CLAUDE.md §66.14).
  /// Private: visible only to this user or an admin (§66.5), never in the ordinary Character DTO.
  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  modelProfile    ModelProfile     @relation(fields: [modelProfileId], references: [id])
  createdByUser   UserProfile?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  scheduledEvents ScheduledEvent[]

  @@index([handle])
  @@index([createdByUserId])
  @@map("characters")
}

model Room {
  id     String  @id @default(uuid())
  /// Human-readable room name (optional, same role as the old Simulation.title).
  title  String?
  /// "active" | "archived".
  status String  @default("active")
  /// "global" | "room". Internal only, never a label on screen: the reserved
  /// global row backs the unified feed (Brickr-ux-refine §8.1, §8.2).
  scope  String  @default("room")

  // Extended room metadata (Phase-1 redesign).
  // These fields are schema scaffolding for a future phase; none of them are
  // read or enforced by the current application code.
  /// Optional short description shown in the room list.
  description    String?        @map("description")
  /// Intended to control visibility, but not yet enforced —
  /// findAllVisibleTo still filters only by status and owner.
  /// Stored now so the column exists when the enforcement phase lands.
  visibility     RoomVisibility @default(public) @map("visibility")
  /// Free-form tags for filtering / discovery (unenforced scaffolding).
  tags           String[]       @default([]) @map("tags")
  /// UI theme identifier (e.g. "default", "dark") (unenforced scaffolding).
  theme          String?        @map("theme")
  /// Whether Cast characters may join this room autonomously (unenforced scaffolding).
  castAutonomous Boolean        @default(true) @map("cast_autonomous")

  /// Public to everyone, unlike Character ownership (§66.6). Null for rooms
  /// created before login existed, and for the reserved global row.
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// Newest post or reply anywhere in this room. Denormalised so the room
  /// list can order by activity without aggregating posts (§8.1).
  lastActivityAt  DateTime @default(now()) @map("last_activity_at")

  posts           Post[]
  memberships     RoomMembership[]
  scheduledEvents ScheduledEvent[]
  createdByUser   UserProfile?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([scope, status, lastActivityAt])
  @@index([createdByUserId, status, lastActivityAt])
  @@map("rooms")
}

model Post {
  id     String @id @default(uuid())
  roomId String @map("room_id")

  /// Character id, or the id of the signed-in account that wrote the post.
  /// Deliberately not a foreign key: user posts and character posts share
  /// one table, and a user is not a Character row.
  authorId String @map("author_id")

  content  String
  imageUrl String?  @map("image_url") @db.Text
  mentions String[] @default([])

  replyTo String? @map("reply_to")
  quoteOf String? @map("quote_of")

  createdAt DateTime @default(now()) @map("created_at")

  /// Root of the thread this post belongs to; a top-level post points at itself.
  /// Denormalised on purpose (§8.3): recursing over `replyTo` cannot page 20
  /// threads across every room at a usable speed. No Prisma self relation — the
  /// value is kept correct by the publishing transaction and its tests.
  threadRootId String @map("thread_root_id")

  /// On a root: the newest activity anywhere in its thread, which is what the
  /// feed orders by. On a reply: its own creation time. A quote repost starts a
  /// new thread and never bumps the post it quotes.
  threadActivityAt DateTime @map("thread_activity_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  replyToPost Post?  @relation("PostReplies", fields: [replyTo], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies     Post[] @relation("PostReplies")

  quoteOfPost Post?  @relation("PostQuotes", fields: [quoteOf], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quotedBy    Post[] @relation("PostQuotes")

  scheduledEvents           ScheduledEvent[] @relation("ScheduledEventPost")
  scheduledEventsAsRoot     ScheduledEvent[] @relation("ScheduledEventThreadRoot")

  @@index([roomId, createdAt])
  @@index([replyTo])
  @@index([quoteOf])
  /// Feed paging: roots (`replyTo = null`) ordered by thread activity, globally
  /// and per room. The third index reads one thread's posts in order.
  @@index([replyTo, threadActivityAt, id])
  @@index([roomId, replyTo, threadActivityAt, id])
  @@index([threadRootId, createdAt, id])
  @@map("posts")
}

model UserProfile {
  /// One row per account, created by signup or the admin bootstrap. The seeded
  /// pre-login singleton is gone (§8.2), but the credential columns stay
  /// nullable: tightening them is a separate change from this phase.
  id          String  @id
  displayName String  @map("display_name")
  description String  @default("")
  avatarUrl   String? @map("avatar_url") @db.Text

  /// Set once at signup, never editable (§66.1). Uniqueness lives in `handles`.
  handle String?

  // Credentials. Private: never part of any DTO (§66.1).
  email        String?   @unique
  passwordHash String?   @map("password_hash")
  /// Self-declared at signup, gates the 18+ check, never returned (§66.1).
  birthdate    DateTime? @db.Date

  // Optional public profile fields (§66.1). Region stops at prefecture/state.
  country    String?
  region     String?
  interests  String[] @default([])
  occupation String?
  xHandle    String?  @map("x_handle")

  /// Plain boolean instead of a role model, by design (§66.7, §60).
  isAdmin Boolean @default(false) @map("is_admin")
  /// "active" | "suspended" (§66.12).
  status  String  @default("active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions            Session[]
  issuedInviteCodes   InviteCode[] @relation("InviteCodeIssuer")
  redeemedInviteCodes InviteCode[] @relation("InviteCodeRedeemer")
  createdCharacters   Character[]
  createdRooms        Room[]
  tokenUsage          TokenUsage?

  @@index([handle])
  @@map("user_profiles")
}

model Session {
  /// SHA-256 of the opaque cookie token. The raw token only ever exists in the
  /// cookie, so a database dump cannot be replayed as a login (§66.11).
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Shared handle namespace for users and characters. The primary key is what
/// actually prevents a user from taking a character handle (§66.13).
model HandleOwner {
  handle String @id

  /// "user" | "character".
  ownerType String   @map("owner_type")
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([ownerType, ownerId])
  @@map("handles")
}

/// Single-use signup invitation issued by an admin (§66.9).
model InviteCode {
  code       String    @id
  issuedById String    @map("issued_by_id")
  usedById   String?   @map("used_by_id")
  usedAt     DateTime? @map("used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  issuedBy UserProfile  @relation("InviteCodeIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  usedBy   UserProfile? @relation("InviteCodeRedeemer", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([issuedById])
  @@map("invite_codes")
}

model ApplicationSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("application_settings")
}

/// Persistent membership record that tracks every participant (user or character)
/// in a room, along with their role and lifecycle status (Phase-1 redesign, #145).
///
/// Polymorphic design: Prisma does not support polymorphic relations natively,
/// so `memberId` is a plain String. The service layer is responsible for
/// resolving it to the correct UserProfile or Character row.
///
/// Constraints enforced at the service layer (not expressible as DB constraints):
///   - Only users may hold the `owner` role.
///   - Characters may only hold the `member` role.
///   - `banned` → `removed` is the only allowed transition out of `banned`.
model RoomMembership {
  id         String       @id @default(uuid())
  roomId     String       @map("room_id")
  memberKind MemberKind   @map("member_kind")
  memberId   String       @map("member_id")
  role       MemberRole   @default(member) @map("role")
  status     MemberStatus @default(pending) @map("status")

  /// Who sent the invitation. Null when the member joined without an invitation
  /// (e.g. self-join on a public room). Kept as a plain String for the same
  /// polymorphic reason as `memberId`.
  invitedById String?   @map("invited_by_id")
  invitedAt   DateTime? @map("invited_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Each (room, memberKind, memberId) triple must be unique so that a user or
  /// character cannot hold two concurrent memberships in the same room.
  @@unique([roomId, memberKind, memberId])
  /// Efficient lookup of all active members in a room (e.g. for responder selection).
  @@index([roomId, status])
  /// Efficient lookup of all rooms a given member belongs to.
  @@index([memberId, memberKind])
  @@map("room_memberships")
}

/// Lifecycle status of a scheduled background event.
///
/// Allowed transitions (enforced at the service/worker layer):
///   pending     → processing (atomic claim by a worker)
///   processing  → completed | failed (worker outcome)
///   pending     → cancelled (room archived/deleted, or cast removed/banned)
///   processing  → cancelled (rare: room archived while worker holds the lock)
///   failed      → pending   (retry, up to maxAttempts)
enum EventStatus {
  pending
  processing
  completed
  failed
  cancelled
}

/// Asynchronous background event queue (design spec §9).
///
/// A single DB table acts as the shared queue; a separate worker process polls
/// it and executes each event. The atomic claim uses a conditional UPDATE so
/// that only one worker can own a given event at a time, even under concurrent
/// polling (§9: "pending かつ期限到来済みを条件付き更新で原子的にロック").
///
/// Deduplication: at most one pending event per (type, roomId, postId,
/// characterId) combination is allowed. The unique index enforces this at the
/// DB level so the application never needs to check first.
///
/// Cancellation: when a Room is archived/deleted, or a Cast is removed/banned,
/// all pending/processing events for that room or cast are set to cancelled.
model ScheduledEvent {
  id           String      @id @default(uuid())
  type         String      // 'character.respond' | 'character.join.request' | etc.
  status       EventStatus @default(pending)
  scheduledAt  DateTime    @map("scheduled_at")

  /// The room this event belongs to. Null only for global/system events (none defined yet).
  roomId       String?     @map("room_id")
  /// The post that triggered this event, if applicable.
  postId       String?     @map("post_id")
  /// The thread root of the triggering post, if applicable.
  threadRootId String?     @map("thread_root_id")
  /// The character this event is for, if applicable.
  characterId  String?     @map("character_id")

  room         Room?       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  post         Post?       @relation("ScheduledEventPost", fields: [postId], references: [id], onDelete: SetNull)
  threadRoot   Post?       @relation("ScheduledEventThreadRoot", fields: [threadRootId], references: [id], onDelete: SetNull)
  character    Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)

  /// Worker that currently holds the lock. Null when status is not processing.
  lockedBy     String?     @map("locked_by")
  /// When the lock was acquired. Used to reclaim events from crashed workers.
  lockedAt     DateTime?   @map("locked_at")

  /// Number of execution attempts so far (incremented on each claim).
  attempts     Int         @default(0)
  /// Last error message, for debugging failed events.
  lastError    String?     @map("last_error")

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  /// Primary polling index: find pending events whose scheduled time has arrived.
  @@index([status, scheduledAt])
  /// Lock-reclaim index: find events held by a worker whose lock has expired.
  @@index([status, lockedAt])
  /// Deduplication: at most one pending event per (type, roomId, postId, characterId).
  /// Partial uniqueness (only for pending) cannot be expressed in Prisma schema;
  /// the repository enforces it by checking before insert.
  @@index([type, roomId, postId, characterId, status])
  @@map("scheduled_events")
}

/// Running per-user LLM token totals (CLAUDE.md §66.4). One row per user,
/// incremented on every successful character generation their post triggered —
/// a log of every generation would grow without bound for no benefit, since
/// nothing here needs a history, only a running count.
model TokenUsage {
  userId       String @id @map("user_id")
  inputTokens  Int    @default(0) @map("input_tokens")
  outputTokens Int    @default(0) @map("output_tokens")
  totalTokens  Int    @default(0) @map("total_tokens")

  updatedAt DateTime @updatedAt @map("updated_at")

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("token_usages")
}
